# Appwrite Cloud Configuration
# Note: Public variables exposed to Vite must start with VITE_
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=YOUR_APPWRITE_PROJECT_ID
VITE_DATABASE_ID=analyzer
VITE_FUNCTION_ID=analyse

# Optional server key for automated schema provisioning script (never committed or exposed to frontend)
APPWRITE_API_KEY=
